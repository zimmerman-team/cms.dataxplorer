# Settings for running the CMS on this machine (make dev). Copy to .env;
# `make setup` does that. In Docker, infra.dx sets these instead.
HOST=0.0.0.0
PORT=1337

API_TOKEN_SALT=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ADMIN_JWT_SECRET=tobemodified
APP_KEYS="toBeModified1,toBeModified2"

# Database. Locally, SQLite in .tmp/data.db needs nothing installed.
# With docker-compose.yml, use postgres and fill in the rest.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
NODE_ENV=development
